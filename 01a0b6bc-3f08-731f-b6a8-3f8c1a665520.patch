 create index if not exists media_assets_category_idx on public.media_assets (category);
 
+-- ============================================================================
+--  LE RÉSEAU : les personnes et leur place dans le mariage
+--
+--  Jusqu’ici, tout pendait au site (`site_id` partout) et une personne
+--  n’existait qu’en tant que réponse à un formulaire. Ici, la personne devient
+--  un objet à part entière, et `wedding_members` dit ce qu’elle fait dans un
+--  mariage donné. Le mini-site devient un rendu du mariage, pas son contenant.
+--
+--  Voir docs/noyau-reseau.md pour les règles de permission, appliquées côté
+--  serveur dans server/people.js — jamais dans le navigateur.
+-- ============================================================================
+
+-- Une personne, et sa carte. `card` porte le verso (disponibilité, repas,
+-- mobilité, prestations, pièces) : ces champs ne servent pas à filtrer, ils
+-- appartiennent à la personne et changent avec son rôle.
+create table if not exists public.people (
+  id                 bigint generated by default as identity primary key,
+  first_name         text not null default '',
+  last_name          text not null default '',
+  photo              text not null default '',
+  home_city          text not null default '',
+  trade              text not null default '',
+  bio                text not null default '',
+  email              text not null default '',
+  phone              text not null default '',
+  website            text not null default '',
+  social             text not null default '',
+  -- 'maries' : les mariés seulement · 'participants' : les membres du mariage
+  -- · 'carte' : quiconque voit la carte. Jamais public par défaut.
+  contact_visibility text not null default 'participants',
+  card               jsonb not null default '{}'::jsonb,
+  created_at         timestamptz not null default now(),
+  updated_at         timestamptz not null default now()
+);
+
+create index if not exists people_city_idx on public.people (home_city);
+
+-- La clé personnelle : un jeton par personne, stocké **haché**. Le clair n’est
+-- renvoyé qu’une fois, à la création (POST /api/people). C’est la même
+-- mécanique que les clés d’édition des sites — aucun fournisseur d’email n’est
+-- nécessaire, et le clair ne circule jamais deux fois.
+create table if not exists public.person_secrets (
+  person_id  bigint primary key references public.people (id) on delete cascade,
+  key_hash   text not null,            -- sha256(jeton) en hexadécimal, 64 caractères
+  created_at timestamptz not null default now()
+);
+
+-- La place d’une personne dans un mariage. Le rôle ne vit QUE ici : une même
+-- personne peut être témoin d’un mariage et prestataire d’un autre.
+create table if not exists public.wedding_members (
+  id         bigint generated by default as identity primary key,
+  site_id    bigint not null references public.wedding_sites (id) on delete cascade,
+  person_id  bigint not null references public.people (id) on delete cascade,
+  role_id    text not null default '',   -- une clé de FULL_ROLES_TAXONOMY
+  status     text not null default 'confirme',
+  joined_at  timestamptz not null default now(),
+  unique (site_id, person_id)
+);
+
+create index if not exists wedding_members_site_idx on public.wedding_members (site_id);
+create index if not exists wedding_members_person_idx on public.wedding_members (person_id);
+
+-- ----------------------------------------------------------------------------
+--  Le comptoir partagé (la page « le mariage, en entier »)
+--
+--  Une ligne par univers : ce que les invités ont pris, les morceaux qu’ils ont
+--  demandés et le journal des reçus. Le couple n’a rien à faire : la page des
+--  mariés lit cette ligne et se remplit toute seule (voir server/live.js et
+--  api/wedding-live.js). Sans base distante, la même mécanique tourne dans le
+--  navigateur (`src/lib/localApi.ts`) : aucune ligne de front ne change.
+-- ----------------------------------------------------------------------------
+create table if not exists public.wedding_live (
+  style_id   text primary key,
+  payload    jsonb not null default '{"prises":[],"demandes":[],"journal":[]}'::jsonb,
+  updated_at timestamptz not null default now()
+);
+
 -- ----------------------------------------------------------------------------
 --  Clés d’édition
 --
