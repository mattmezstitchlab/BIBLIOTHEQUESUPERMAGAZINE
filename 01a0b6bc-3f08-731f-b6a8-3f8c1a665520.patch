+/* ————————————————————————— LE PROMPT MAÎTRE ————————————————————————— */
+
+export interface FicheDeProduction {
+  /** `MM-JJ`. */
+  jour: string;
+  dateLongue: string;
+  /** Les cinq blocs, dans l'ordre où ils se lisent. */
+  identite: string[];
