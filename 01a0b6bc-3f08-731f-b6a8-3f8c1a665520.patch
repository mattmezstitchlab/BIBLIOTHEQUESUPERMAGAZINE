+          : `Les entrées de votre espace, dans l’ordre du jour : ${personne.entrees.join(', ')}. ${pas.sage}`,
+      source: `${personne.nom} · ${pas.nom}`,
+    },
+    {
+      rubrique: 'Les gens',
+      titre: (() => {
+        const [un, deux] = choisirDeux(metiers(), graine);
