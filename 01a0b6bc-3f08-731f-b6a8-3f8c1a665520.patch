+  const saisons = useMemo(() => lesQuatreSaisons({ roleId }), [roleId]);
+
+  const siens = useMemo(() => (role ? articlesPourRole(role.id) : null), [role]);
+  const fil = useMemo(() => filRougeDuJour(jour.date), [jour.date]);
