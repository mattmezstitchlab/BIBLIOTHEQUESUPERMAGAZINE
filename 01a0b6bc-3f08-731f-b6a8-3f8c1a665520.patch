+/** Les mots de chaque thème, écrits une fois : ils ouvrent l'édition et l'ordonnent. */
+const MOTS_JOUR_J = ['heure', 'programme', 'déroulé', 'minut', 'timing', 'chrono', 'après', 'aube', '22h', '23h'];
