+        <div
+          className={`h-1.5 w-full rounded-b-[6px] transition-colors ${visible ? 'bg-[#0B0C12]' : 'bg-transparent'}`}
+          aria-hidden="true"
+        />
+
+        <AnimatePresence initial={false}>
+          {visible && (
+            <motion.div
+              key={annonce!.id}
+              initial={{ height: 0, opacity: 0 }}
+              animate={{ height: 'auto', opacity: 1 }}
