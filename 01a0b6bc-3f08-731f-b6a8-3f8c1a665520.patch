+
+/** Le métier montré par défaut : un traiteur, dans un château moderne. */
+const ROLE_DEFAUT = 'Traiteur Haute Gastronomie';
+const STYLE_DEFAUT = 'chateau-moderne';
+
+export default function VendorStudio() {
