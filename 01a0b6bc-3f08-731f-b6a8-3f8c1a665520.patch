+      icon: Clock,
+      content: (
+        <PhoneModule eyebrow="Prochain top">
+          <div className="text-[12.5px] font-bold text-black">{next?.title}</div>
+          <div className="mt-0.5 font-mono text-[9.5px] text-black/45">
