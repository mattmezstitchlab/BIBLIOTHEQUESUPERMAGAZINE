+export const JOURS_NOMMES: JourNomme[] = TABLE.map(([mois, jour, nom, genre], i) => ({
+  mois,
+  jour,
+  nom,
+  genre,
+  ordinal: i + 1,
+}));
+
+/** Les deux jours qui n'ont pas de couverture à eux : les jokers. */
+export const JOKERS_DU_CALENDRIER = [
+  { numero: 53, nom: 'le jour de trop', date: '31 décembre', saint: 'Sylvestre' },
+  { numero: 54, nom: 'le jour bissextile', date: '29 février', saint: null },
+] as const;
+
+/** Le joker d'une date, ou `null` : le 31 décembre et le 29 février. */
+export function jokerDuJour(date: Date): (typeof JOKERS_DU_CALENDRIER)[number] | null {
+  const mois = date.getMonth() + 1;
+  const jour = date.getDate();
+  return JOKERS_DU_CALENDRIER.find((j) => (j.numero === 53 ? mois === 12 && jour === 31 : mois === 2 && jour === 29)) ?? null;
+}
+
+/** Le prénom du jour, ou `null` les deux jours jokers. */
+export function jourNomme(date: Date): JourNomme | null {
+  return JOURS_NOMMES.find((j) => j.mois === date.getMonth() + 1 && j.jour === date.getDate()) ?? null;
+}
+
+/** Le prénom du jour, écrit simplement. */
+export function nomDuJour(date: Date): string {
+  const j = jourNomme(date);
+  if (j) return j.nom;
+  const joker = jokerDuJour(date);
+  // Les deux jokers portent quand même leur fête : Sylvestre le 31 décembre,
+  // et rien le 29 février — c'est le jour de trop, il n'a pas de prénom.
+  return joker ? (joker.saint ?? joker.nom) : '';
+}
+
+/** Les jours d'un mois, dans l'ordre. */
+export function joursDuMois(mois: number): JourNomme[] {
+  return JOURS_NOMMES.filter((j) => j.mois === mois);
+}
