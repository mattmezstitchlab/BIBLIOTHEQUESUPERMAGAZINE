+  {
+    keys: ['bal', 'danse', 'premiere danse', 'ouverture de bal', 'valse'],
+    track: {
+      title: 'Ouverture de bal',
+      subtitle: 'Votre première danse, celle qu’on garde',
+      src: '/audio/danse-perfect.wav',
+      cover: '/images/danse.jpg',
