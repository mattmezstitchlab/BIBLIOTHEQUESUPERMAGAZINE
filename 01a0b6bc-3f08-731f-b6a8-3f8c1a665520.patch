+  const pas = pasDeTempsDeLaSemaine(semaine);
+  const [du, fin] = bornesDeLaSemaine(annee, semaine);
+  const lune = phaseDeLune(du);
+
+  const personne = roleDe(options);
+  const univers = universDe(options);
+  const papiers = papiersDe(options);
+
+  const graine = signer(
