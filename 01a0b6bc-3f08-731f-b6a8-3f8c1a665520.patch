+
+/** Les petits suppléments : leurs mots changent, la forme reste. */
+const PLUS_PAR_REGISTRE: Record<Registre, Array<{ id: string; label: string; detail: (style: WeddingStyle) => string; prix: number; quantite?: number }>> = {
